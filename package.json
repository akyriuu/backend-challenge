{
  "name": "backend-challenge",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test src test/toolchain.spec.ts",
    "test:integration": "bun test test/integration --timeout 30000",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "check": "bun run typecheck && bun run lint && bun run test",
    "check:all": "bun run check && bun run test:integration",
    "migration:up": "bun run src/infrastructure/database/migrate.ts up",
    "migration:down": "bun run src/infrastructure/database/migrate.ts down",
    "migration:list": "bun run src/infrastructure/database/migrate.ts list"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1112.0",
    "@mikro-orm/core": "^7.1.12",
    "@mikro-orm/migrations": "^7.1.12",
    "@mikro-orm/nestjs": "^7.0.2",
    "@mikro-orm/postgresql": "^7.1.12",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "decimal.js": "^10.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bun": "^1.3.14",
    "@types/express": "^5.0.0",
    "@types/node": "^26.2.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
